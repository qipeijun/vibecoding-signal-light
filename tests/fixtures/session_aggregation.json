[
  {
    "name": "empty sessions return idle",
    "now": 100,
    "sessions": {},
    "expected_aggregate": "idle"
  },
  {
    "name": "older attention outranks newer working",
    "now": 100,
    "sessions": {
      "attention": { "signal": "attention", "updated_at": 80 },
      "working": { "signal": "working", "updated_at": 90 }
    },
    "expected_aggregate": "attention"
  },
  {
    "name": "older blocked outranks newer permission",
    "now": 100,
    "sessions": {
      "blocked": { "signal": "blocked", "updated_at": 70 },
      "permission": { "signal": "permission", "updated_at": 90 }
    },
    "expected_aggregate": "blocked"
  },
  {
    "name": "permission outranks attention",
    "now": 100,
    "sessions": {
      "attention": { "signal": "attention", "updated_at": 90 },
      "permission": { "signal": "permission", "updated_at": 80 }
    },
    "expected_aggregate": "permission"
  },
  {
    "name": "working outranks done",
    "now": 100,
    "sessions": {
      "done": { "signal": "done", "updated_at": 99 },
      "working": { "signal": "tool_done", "updated_at": 90 }
    },
    "expected_aggregate": "working"
  },
  {
    "name": "fresh done remains visible",
    "now": 100,
    "sessions": {
      "done": { "signal": "done", "updated_at": 95 }
    },
    "expected_aggregate": "done"
  },
  {
    "name": "done returns to idle after six seconds",
    "now": 100,
    "sessions": {
      "done": { "signal": "done", "updated_at": 93 }
    },
    "expected_aggregate": "idle"
  },
  {
    "name": "working lease expiry becomes stale",
    "now": 2000,
    "sessions": {
      "working": { "signal": "working", "updated_at": 100 }
    },
    "expected_aggregate": "stale"
  },
  {
    "name": "attention lease expiry becomes stale",
    "now": 7301,
    "sessions": {
      "attention": { "signal": "attention", "updated_at": 100 }
    },
    "expected_aggregate": "stale"
  },
  {
    "name": "critical lease expiry becomes stale",
    "now": 86501,
    "sessions": {
      "blocked": { "signal": "blocked", "updated_at": 100 }
    },
    "expected_aggregate": "stale"
  },
  {
    "name": "expired critical state remains yellow over fresh work",
    "now": 90000,
    "sessions": {
      "blocked": { "signal": "blocked", "updated_at": 100 },
      "working": { "signal": "working", "updated_at": 89990 }
    },
    "expected_aggregate": "stale"
  },
  {
    "name": "expired work is stale even with idle record",
    "now": 2000,
    "sessions": {
      "working": { "signal": "working", "updated_at": 100 },
      "idle": { "signal": "idle", "updated_at": 1990 }
    },
    "expected_aggregate": "stale"
  },
  {
    "name": "record beyond lease and retention is pruned",
    "now": 90000,
    "session_ttl_seconds": 10,
    "sessions": {
      "blocked": { "signal": "blocked", "updated_at": 100 }
    },
    "expected_aggregate": "idle"
  },
  {
    "name": "unknown signal falls back to idle",
    "now": 100,
    "sessions": {
      "unknown": { "signal": "mystery", "updated_at": 99 }
    },
    "expected_aggregate": "idle"
  }
]
