#!/usr/bin/env bash
set -euo pipefail

if [[ $EUID -eq 0 ]]; then
  echo "错误：请勿使用 sudo 运行本脚本。" >&2
  echo "sudo 会让构建产物属主变成 root，导致后续普通用户构建时 Permission denied。" >&2
  echo "如需清理 root 属主残留，脚本会自动用 sudo 处理。" >&2
  exit 1
fi

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export COPYFILE_DISABLE=1
VERSION="${SIGNAL_LIGHT_VERSION:-1.0.6.2}"
INSTALLER_SIGN_IDENTITY="${SIGNAL_LIGHT_INSTALLER_SIGN_IDENTITY:-}"

APP_PATH="$ROOT_DIR/dist/build/Signal Light.app"
PKG_ROOT="$ROOT_DIR/dist/pkg-root"
PKG_PATH="$ROOT_DIR/dist/Signal-Light-Installer.pkg"
INSTALL_BIN_DIR="$PKG_ROOT/usr/local/bin"
PKG_SCRIPTS_DIR="$ROOT_DIR/dist/pkg-scripts"

"$ROOT_DIR/scripts/build-signal-light-app" >/dev/null

if ! rm -rf "$PKG_ROOT" "$PKG_SCRIPTS_DIR" "$PKG_PATH" 2>/dev/null; then
  echo "检测到 root 属主残留文件，使用 sudo 清理..." >&2
  sudo rm -rf "$PKG_ROOT" "$PKG_SCRIPTS_DIR" "$PKG_PATH"
fi
mkdir -p "$PKG_ROOT/Applications" "$INSTALL_BIN_DIR"
cp -R "$APP_PATH" "$PKG_ROOT/Applications/Signal Light.app"

cat > "$INSTALL_BIN_DIR/signal-light" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

TARGET="/Applications/Signal Light.app/Contents/Resources/bin/signal-light"
if [[ ! -x "$TARGET" ]]; then
  echo "Signal Light.app 未安装或已损坏。请运行安装器：" >&2
  echo "  open \"dist/Signal-Light-Installer.pkg\"" >&2
  exit 1
fi
exec "$TARGET" "$@"
SCRIPT

cat > "$INSTALL_BIN_DIR/codex-signal-hook" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

TARGET="/Applications/Signal Light.app/Contents/Resources/bin/codex-signal-hook"
if [[ ! -x "$TARGET" ]]; then
  echo "Signal Light.app 未安装或已损坏。请运行安装器：" >&2
  echo "  open \"dist/Signal-Light-Installer.pkg\"" >&2
  exit 1
fi
exec "$TARGET" "$@"
SCRIPT

cat > "$INSTALL_BIN_DIR/claude-code-signal-hook" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

TARGET="/Applications/Signal Light.app/Contents/Resources/bin/claude-code-signal-hook"
if [[ ! -x "$TARGET" ]]; then
  echo "Signal Light.app 未安装或已损坏。请运行安装器：" >&2
  echo "  open \"dist/Signal-Light-Installer.pkg\"" >&2
  exit 1
fi
exec "$TARGET" "$@"
SCRIPT

cat > "$INSTALL_BIN_DIR/cursor-signal-hook" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

TARGET="/Applications/Signal Light.app/Contents/Resources/bin/cursor-signal-hook"
if [[ ! -x "$TARGET" ]]; then
  echo "Signal Light.app 未安装或已损坏。请运行安装器：" >&2
  echo "  open \"dist/Signal-Light-Installer.pkg\"" >&2
  exit 1
fi
exec "$TARGET" "$@"
SCRIPT

cat > "$INSTALL_BIN_DIR/signal-light-uninstall" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

APP_PATH="/Applications/Signal Light.app"
STATE_DIR="${SIGNAL_LIGHT_STATE_DIR:-/private/tmp/signal-light}"
BIN_PATHS=(
  "/usr/local/bin/signal-light"
  "/usr/local/bin/codex-signal-hook"
  "/usr/local/bin/claude-code-signal-hook"
  "/usr/local/bin/cursor-signal-hook"
  "/usr/local/bin/signal-light-uninstall"
)

# 1. 退出运行中的 App
osascript -e 'tell application "Signal Light" to quit' 2>/dev/null || true
killall signal-light-mac 2>/dev/null || true
sleep 1

# 2. 收集需要删除且存在的路径
paths=()
[[ -e "$APP_PATH" ]] && paths+=("$APP_PATH")
for p in "${BIN_PATHS[@]}"; do
  [[ -e "$p" ]] && paths+=("$p")
done
[[ -e "$STATE_DIR" ]] && paths+=("$STATE_DIR")

if [[ ${#paths[@]} -eq 0 ]]; then
  echo "Signal Light 未安装，无需卸载。"
  exit 0
fi

# 3. 构建 rm 命令（单引号转义路径）
cmds=""
for p in "${paths[@]}"; do
  q="'${p//\'/\'\\\'\'}'"
  cmds+="rm -rf $q; "
done

# 4. 先尝试普通权限删除
if bash -c "$cmds" 2>/dev/null; then
  echo "Signal Light 已卸载。"
  exit 0
fi

# 5. 权限不足，用 osascript 提权（弹出 macOS 密码对话框）
echo "需要管理员权限来卸载，请在弹出的对话框中输入密码..." >&2
asc="${cmds//\\/\\\\}"
asc="${asc//\"/\\\"}"
osascript -e "do shell script \"$asc\" with administrator privileges"
echo "Signal Light 已卸载。"
SCRIPT

chmod +x "$INSTALL_BIN_DIR/signal-light" \
  "$INSTALL_BIN_DIR/codex-signal-hook" \
  "$INSTALL_BIN_DIR/claude-code-signal-hook" \
  "$INSTALL_BIN_DIR/cursor-signal-hook" \
  "$INSTALL_BIN_DIR/signal-light-uninstall"

xattr -cr "$PKG_ROOT" 2>/dev/null || true
xattr -rd com.apple.provenance "$PKG_ROOT" 2>/dev/null || true
find "$PKG_ROOT" -name '._*' -delete

mkdir -p "$PKG_SCRIPTS_DIR"
cat > "$PKG_SCRIPTS_DIR/postinstall" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

console_user="$(/usr/bin/stat -f %Su /dev/console 2>/dev/null || true)"
if [[ -n "$console_user" && "$console_user" != "root" && "$console_user" != "loginwindow" ]]; then
  user_home="$(/usr/bin/dscl . -read "/Users/$console_user" NFSHomeDirectory 2>/dev/null | /usr/bin/awk '{print $2}' || true)"
  if [[ -n "$user_home" && -d "$user_home" ]]; then
    if ! /usr/bin/sudo -u "$console_user" HOME="$user_home" /usr/local/bin/signal-light install-hooks --quiet 2>/dev/null; then
      echo "warning: hook 自动写入失败，请稍后运行 signal-light doctor 检查接线状态。" >&2
    fi
  fi
fi

/usr/bin/open "/Applications/Signal Light.app" || true
exit 0
SCRIPT
chmod +x "$PKG_SCRIPTS_DIR/postinstall"

pkgbuild_args=(
  pkgbuild
  --root "$PKG_ROOT"
  --scripts "$PKG_SCRIPTS_DIR"
  --identifier "com.vibecoding.signal-light"
  --version "${VERSION}"
  --install-location "/"
)
if [[ -n "$INSTALLER_SIGN_IDENTITY" ]]; then
  pkgbuild_args+=(--sign "$INSTALLER_SIGN_IDENTITY" --timestamp)
fi
"${pkgbuild_args[@]}" "$PKG_PATH"

# macOS Sonoma+ 会给所有文件附加 com.apple.provenance xattr（SIP 保护，不可删除）。
# pkgbuild 内部的 cpio 归档器会为带 xattr 的文件生成 ._ AppleDouble 文件，
# 污染 pkg payload，导致 macOS 安装器无法正确安装 app。
# 这里在 pkgbuild 之后展开 pkg，清理 ._ 文件，再重新打包。
strip_appledouble_from_pkg() {
  local pkg="$1"
  local tmp_dir
  tmp_dir="$(mktemp -d)"
  trap 'rm -rf "$tmp_dir"' RETURN

  if ! pkgutil --expand "$pkg" "$tmp_dir/expanded" 2>/dev/null; then
    echo "warning: 无法展开 pkg 进行 ._ 清理，跳过。" >&2
    return 0
  fi

  # 清理 Scripts 目录里的 ._ 文件
  find "$tmp_dir/expanded/Scripts" -name '._*' -delete 2>/dev/null || true

  # 检查 Payload 里是否有 ._ 文件
  local payload="$tmp_dir/expanded/Payload"
  if [[ ! -f "$payload" ]]; then
    pkgutil --flatten "$tmp_dir/expanded" "$pkg" 2>/dev/null
    return 0
  fi

  # 拆开 Payload（gzip + cpio），用 COPYFILE_DISABLE=1 重新打包
  local payload_dir="$tmp_dir/payload"
  mkdir -p "$payload_dir"
  (cd "$payload_dir" && gzip -dc "$payload" | cpio -i 2>/dev/null)
  if [[ $? -ne 0 ]]; then
    echo "warning: 无法拆开 pkg Payload 进行 ._ 清理，跳过。" >&2
    rm -rf "$tmp_dir"
    return 0
  fi

  # 删除 ._ 文件
  find "$payload_dir" -name '._*' -delete 2>/dev/null || true

  # 重新打包 Payload（COPYFILE_DISABLE=1 阻止 cpio 生成 ._ 文件）
  (cd "$payload_dir" && COPYFILE_DISABLE=1 find . -print | cpio -o -H odc 2>/dev/null | gzip > "$payload")

  # 重新 flatten
  pkgutil --flatten "$tmp_dir/expanded" "$pkg" 2>/dev/null
}

strip_appledouble_from_pkg "$PKG_PATH"

if [[ -n "${APPLE_ID:-}" && -n "${APPLE_TEAM_ID:-}" && -n "${APPLE_APP_SPECIFIC_PASSWORD:-}" ]]; then
  if [[ -z "$INSTALLER_SIGN_IDENTITY" ]]; then
    echo "Apple notarization requires SIGNAL_LIGHT_INSTALLER_SIGN_IDENTITY." >&2
    exit 1
  fi
  xcrun notarytool submit "$PKG_PATH" \
    --apple-id "$APPLE_ID" \
    --team-id "$APPLE_TEAM_ID" \
    --password "$APPLE_APP_SPECIFIC_PASSWORD" \
    --wait
  xcrun stapler staple "$PKG_PATH"
  xcrun stapler validate "$PKG_PATH"
fi

echo "$PKG_PATH"
