#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export COPYFILE_DISABLE=1
VERSION="${SIGNAL_LIGHT_VERSION:-1.0.3}"
INSTALLER_SIGN_IDENTITY="${SIGNAL_LIGHT_INSTALLER_SIGN_IDENTITY:-}"

APP_PATH="$ROOT_DIR/dist/build/Signal Light.app"
PKG_ROOT="$ROOT_DIR/dist/pkg-root"
PKG_PATH="$ROOT_DIR/dist/Signal-Light-Installer.pkg"
INSTALL_BIN_DIR="$PKG_ROOT/usr/local/bin"
PKG_SCRIPTS_DIR="$ROOT_DIR/dist/pkg-scripts"

"$ROOT_DIR/scripts/build-signal-light-app" >/dev/null

rm -rf "$PKG_ROOT" "$PKG_SCRIPTS_DIR" "$PKG_PATH"
mkdir -p "$PKG_ROOT/Applications" "$INSTALL_BIN_DIR"
cp -R "$APP_PATH" "$PKG_ROOT/Applications/Signal Light.app"

cat > "$INSTALL_BIN_DIR/signal-light" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

exec "/Applications/Signal Light.app/Contents/Resources/bin/signal-light" "$@"
SCRIPT

cat > "$INSTALL_BIN_DIR/codex-signal-hook" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

exec "/Applications/Signal Light.app/Contents/Resources/bin/codex-signal-hook" "$@"
SCRIPT

cat > "$INSTALL_BIN_DIR/claude-code-signal-hook" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

exec "/Applications/Signal Light.app/Contents/Resources/bin/claude-code-signal-hook" "$@"
SCRIPT

cat > "$INSTALL_BIN_DIR/signal-light-uninstall" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

exec "/Applications/Signal Light.app/Contents/Resources/bin/signal-light" uninstall "$@"
SCRIPT

chmod +x "$INSTALL_BIN_DIR/signal-light" \
  "$INSTALL_BIN_DIR/codex-signal-hook" \
  "$INSTALL_BIN_DIR/claude-code-signal-hook" \
  "$INSTALL_BIN_DIR/signal-light-uninstall"

xattr -cr "$PKG_ROOT" 2>/dev/null || true
xattr -rd com.apple.provenance "$PKG_ROOT" 2>/dev/null || true
find "$PKG_ROOT" -name '._*' -delete

mkdir -p "$PKG_SCRIPTS_DIR"
cat > "$PKG_SCRIPTS_DIR/postinstall" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

console_user="$(/usr/bin/stat -f %Su /dev/console 2>/dev/null || true)"
if [[ -n "$console_user" && "$console_user" != "root" && "$console_user" != "loginwindow" ]]; then
  user_home="$(/usr/bin/dscl . -read "/Users/$console_user" NFSHomeDirectory 2>/dev/null | /usr/bin/awk '{print $2}' || true)"
  if [[ -n "$user_home" && -d "$user_home" ]]; then
    /usr/bin/sudo -u "$console_user" HOME="$user_home" /usr/local/bin/signal-light install-hooks --quiet || true
  fi
fi

/usr/bin/open "/Applications/Signal Light.app" || true
exit 0
SCRIPT
chmod +x "$PKG_SCRIPTS_DIR/postinstall"

pkgbuild_args=(
  pkgbuild
  --root "$PKG_ROOT"
  --scripts "$PKG_SCRIPTS_DIR"
  --identifier "com.vibecoding.signal-light"
  --version "${VERSION}"
  --install-location "/"
)
if [[ -n "$INSTALLER_SIGN_IDENTITY" ]]; then
  pkgbuild_args+=(--sign "$INSTALLER_SIGN_IDENTITY" --timestamp)
fi
"${pkgbuild_args[@]}" "$PKG_PATH"

if [[ -n "${APPLE_ID:-}" && -n "${APPLE_TEAM_ID:-}" && -n "${APPLE_APP_SPECIFIC_PASSWORD:-}" ]]; then
  if [[ -z "$INSTALLER_SIGN_IDENTITY" ]]; then
    echo "Apple notarization requires SIGNAL_LIGHT_INSTALLER_SIGN_IDENTITY." >&2
    exit 1
  fi
  xcrun notarytool submit "$PKG_PATH" \
    --apple-id "$APPLE_ID" \
    --team-id "$APPLE_TEAM_ID" \
    --password "$APPLE_APP_SPECIFIC_PASSWORD" \
    --wait
  xcrun stapler staple "$PKG_PATH"
  xcrun stapler validate "$PKG_PATH"
fi

echo "$PKG_PATH"
