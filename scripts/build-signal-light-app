#!/usr/bin/env bash
set -euo pipefail

if [[ $EUID -eq 0 ]]; then
  echo "错误：请勿使用 sudo 运行本脚本。" >&2
  echo "sudo 会让构建产物属主变成 root，导致后续普通用户构建时 Permission denied。" >&2
  exit 1
fi

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export COPYFILE_DISABLE=1
VERSION="${SIGNAL_LIGHT_VERSION:-1.0.6.2}"
CODESIGN_IDENTITY="${SIGNAL_LIGHT_CODESIGN_IDENTITY:--}"

APP_DIR="$ROOT_DIR/dist/build/Signal Light.app"
CONTENTS_DIR="$APP_DIR/Contents"
MACOS_DIR="$CONTENTS_DIR/MacOS"
RESOURCES_DIR="$CONTENTS_DIR/Resources"
BIN_DIR_RESOURCES="$RESOURCES_DIR/bin"
ICONSET_DIR="$ROOT_DIR/dist/SignalLight.iconset"

swift build --package-path "$ROOT_DIR" -c release
BIN_DIR="$(swift build --package-path "$ROOT_DIR" -c release --show-bin-path)"

if ! rm -rf "$APP_DIR" 2>/dev/null; then
  echo "检测到 root 属主残留文件，使用 sudo 清理..." >&2
  sudo rm -rf "$APP_DIR"
fi
mkdir -p "$MACOS_DIR" "$BIN_DIR_RESOURCES"
cp "$BIN_DIR/signal-light-mac" "$MACOS_DIR/signal-light-mac"
cp "$BIN_DIR/signal-light-cli" "$BIN_DIR_RESOURCES/signal-light"
"$ROOT_DIR/scripts/make-app-icon.py" "$ICONSET_DIR" >/dev/null
cp "$ROOT_DIR/dist/SignalLight.icns" "$RESOURCES_DIR/SignalLight.icns"

cat > "$BIN_DIR_RESOURCES/codex-signal-hook" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$BIN_DIR/signal-light" codex-hook "$@"
SCRIPT

cat > "$BIN_DIR_RESOURCES/claude-code-signal-hook" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$BIN_DIR/signal-light" claude-code-hook "$@"
SCRIPT

cat > "$BIN_DIR_RESOURCES/cursor-signal-hook" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$BIN_DIR/signal-light" cursor-hook "$@"
SCRIPT

chmod +x "$BIN_DIR_RESOURCES/signal-light" \
  "$BIN_DIR_RESOURCES/codex-signal-hook" \
  "$BIN_DIR_RESOURCES/claude-code-signal-hook" \
  "$BIN_DIR_RESOURCES/cursor-signal-hook"

cat > "$CONTENTS_DIR/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key>
  <string>signal-light-mac</string>
  <key>CFBundleIdentifier</key>
  <string>com.vibecoding.signal-light</string>
  <key>CFBundleName</key>
  <string>Signal Light</string>
  <key>CFBundleDisplayName</key>
  <string>Signal Light</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleIconFile</key>
  <string>SignalLight</string>
  <key>CFBundleShortVersionString</key>
  <string>${VERSION}</string>
  <key>CFBundleVersion</key>
  <string>${VERSION}</string>
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSPrincipalClass</key>
  <string>NSApplication</string>
</dict>
</plist>
PLIST

codesign_args=(--force --deep --sign "$CODESIGN_IDENTITY")
if [[ "$CODESIGN_IDENTITY" != "-" ]]; then
  codesign_args+=(--options runtime --timestamp)
fi
codesign "${codesign_args[@]}" "$APP_DIR"

echo "$APP_DIR"
